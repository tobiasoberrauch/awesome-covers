# ============================================
# GenreFlip - Konfiguration
# ============================================
# Kopiere diese Datei zu .env.local und fülle die Werte aus.
#
# SCHNELLSTART:
# 1. Supabase: https://supabase.com (Free Tier) -> Neues Projekt erstellen
# 2. Stripe: https://stripe.com -> Account erstellen, Produkte/Preise anlegen
# 3. Replicate: https://replicate.com -> API Token holen
# 4. npm install && npm run dev
# ============================================

# --- Supabase ---
# Dashboard: https://supabase.com/dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (erstelle Produkte in Stripe Dashboard)
# Pro Plan: €14.99/Monat
STRIPE_PRO_PRICE_ID=price_...
# Creator Plan: €24.99/Monat
STRIPE_CREATOR_PRICE_ID=price_...

# --- Replicate (AI-Inferenz) ---
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GenreFlip
